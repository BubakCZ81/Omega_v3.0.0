indicator("Normalized Relative Vigor Index", shorttitle="NRVGI")

length = input.int(title="Length", defval=10, minval=1)
applyFilling = input.bool(title="Apply Filling ?", defval=false)

rvgi = sum(swma(close - open), length) / sum(swma(high - low), length)
signal = swma(rvgi)

rvgiPlot = plot(100 * rvgi, title="NRVGI", color=color.green)
signalPlot = plot(100 * signal, title="Signal", color=color.red)

fillColor = applyFilling ? (rvgi > signal ? #0ebb23 : #cc0000) : color(color.white, 100)
fill(rvgiPlot, signalPlot, color=fillColor)
