indicator("VW-MACD")

fastLength = input.int(title="Fast Length", defval=12)
slowLength = input.int(title="Slow Length", defval=26)
signalLength = input.int(title="Signal Length", defval=9)
showHistogram = input.bool(title="Show Histogram ?", defval=true)
highlightCrossovers = input.bool(title="Highlight VW-MACD/Signal Crossovers ?", defval=false)
highlightZeroCrossovers = input.bool(title="Highlight Zero Line Crossovers ?", defval=false)
applyFilling = input.bool(title="Apply Ribbon Filling ?", defval=false)

vwmacd = vwma(close, fastLength) - vwma(close, slowLength)
signal = ema(vwmacd, signalLength)
hist = vwmacd - signal

histColor = hist >= 0 ? (hist[1] < hist ? #26A69A : #B2DFDB) : (hist[1] < hist ? #FFCDD2 : #EF5350)

plot(showHistogram ? hist : na, title="Histogram", style=columns, color=histColor)
hline(0, title="Zero Line", linestyle=dotted)

trendColor = vwmacd > signal ? #0ebb23 : color.red

vwmacdColor = applyFilling ? trendColor : #0094ff
signalColor = applyFilling ? trendColor : #ff6a00

vwmacdPlot = plot(vwmacd, title="VW-MACD", color=vwmacdColor)
signalPlot = plot(signal, title="Signal", color=signalColor)

transparent = color(color.white, 100)

fillColor = applyFilling ? trendColor : transparent
fill(vwmacdPlot, signalPlot, color=fillColor)

zeroCrossBgColor = highlightZeroCrossovers ? (vwmacd > 0 ? color.green : color.red) : transparent
bgcolor(zeroCrossBgColor)

plotshape(highlightCrossovers and crossover(vwmacd, signal) ? vwmacd : na, title="Crossover", location=location.absolute, style=shape.circle, size=size.tiny, color=color.green)
plotshape(highlightCrossovers and crossunder(vwmacd, signal) ? vwmacd : na, title="Crossunder", location=location.absolute, style=shape.circle, size=size.tiny, color=color.red)
