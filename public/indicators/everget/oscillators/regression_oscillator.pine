indicator("Regression Oscillator", shorttitle="ROSC")

length = input.int(title="Length", minval=1, defval=63)
linregOffset = input.int(title="Linear Regression Offset", defval=0)
src = input.source(title="Source", defval=close)

rosc = 100 * (src / linreg(src, length, linregOffset) - 1)

roscColor = rosc >= 0.0 ? #0ebb23 : #ff0000

plot(rosc, title="ROSC", linewidth=2, color=roscColor)

hline(0, title="Zero Level", linestyle=dotted, color=#989898)
