indicator("Stochastic Momentum Index", shorttitle="SMI")

q = input(title="Length (Stochastic Lookback)", type=integer, minval=1, defval=13)
r = input.int(title="First Smoothing Length", minval=1, defval=25)
s = input.int(title="Second Smoothing Length", minval=1, defval=2)
signalLength = input.int(title="Signal Length", minval=1, defval=12)
overboughtLevel = input.int(title="Overbought Level", defval=40)
oversoldLevel = input.int(title="Oversold Level", defval=-40)
applyFilling = input.bool(title="Apply Filling ?", defval=false)
src = input.source(title="Source", defval=close)

hhq = highest(high, q)
llq = lowest(low, q)

numerator = ema(ema(src - 0.5 * (hhq + llq), r), s)

denominator = 0.5 * ema(ema(hhq - llq, r), s)

smi = 100 * numerator / denominator

signal = ema(smi, signalLength)

smiPlot = plot(smi, title="SMI", color=#ff3e7d)
signalPlot = plot(signal, title="Signal", color=#3c78d8)

overbought = hline(title="Overbought Level", price=overboughtLevel, linestyle=dotted, color=#e69138)
hline(title="Zero Level", price=0, linestyle=dashed, color=#989898)
oversold = hline(title="Oversold Level", price=oversoldLevel, linestyle=dotted, color=#e69138)

fillColor = applyFilling ? (smi > signal ? #0ebb23 : #cc0000) : color(color.white, 100)
fill(smiPlot, signalPlot, color=fillColor)
