indicator("Rainbow Oscillator", shorttitle="ROSC")

maLength = input.int(title="Moving Average Length", minval=1, defval=2)
maInput = input(title="Moving Average Type", defval="SMA", options=["EMA", "SMA", "VWMA", "WMA"])
highestLookback = input.int(title="Highest Price Lookback", minval=1, defval=10)
lowestLookback = input.int(title="Lowest Price Lookback", minval=1, defval=10)
drawBg = input.bool(title="Draw Backgrounds ?", defval=true)
src = input.source(title="Source", defval=close)

getMA(src, maLength) =>
    ma = 0.0

	if maInput == "EMA"
        ma := ema(src, maLength)

	if maInput == "SMA"
        ma := sma(src, maLength)

	if maInput == "VWMA"
        ma := vwma(src, maLength)

	if maInput == "WMA"
        ma := wma(src, maLength)
    ma

ma1 = getMA(src, maLength)
ma2 = getMA(ma1, maLength)
ma3 = getMA(ma2, maLength)
ma4 = getMA(ma3, maLength)
ma5 = getMA(ma4, maLength)
ma6 = getMA(ma5, maLength)
ma7 = getMA(ma6, maLength)
ma8 = getMA(ma7, maLength)
ma9 = getMA(ma8, maLength)
ma10 = getMA(ma9, maLength)

maMax = max(ma1,
     max(ma2,
     max(ma3,
     max(ma4,
     max(ma5,
     max(ma6,
     max(ma7,
     max(ma8,
     max(ma9,
     ma10)))))))))

maMin = min(ma1,
     min(ma2,
     min(ma3,
     min(ma4,
     min(ma5,
     min(ma6,
     min(ma7,
     min(ma8,
     min(ma9,
     ma10)))))))))

hlDiff = highest(src, highestLookback) - lowest(src, lowestLookback)
average = (ma1 + ma2 + ma3 + ma4 + ma5 + ma6 + ma7 + ma8 + ma9 + ma10) / 10

rosc = hlDiff != 0
         ? 100 * (src - average) / hlDiff
         : 0

band = hlDiff != 0
         ? 100 * (maMax - maMin) / hlDiff
         : 0

roscColor = rosc > 0 ? color.green : color.red

roscPlot = plot(rosc, title="ROSC", style=histogram, linewidth=3, color=roscColor)

upperBandColor = drawBg ? color.gray : color.green
upperBandPlot = plot(band, title="Upper", color=upperBandColor)

middlePlot = plot(0, title="Middle", color=color.gray)

lowerBandColor = drawBg ? color.gray : color.red
lowerBandPlot = plot(-1 * band, title="Lower", color=lowerBandColor)

transparentColor = color(color.white, 100)
upperFillColor = drawBg ? color.green : transparentColor
lowerFillColor = drawBg ? color.red : transparentColor

fill(middlePlot, upperBandPlot, color=upperFillColor)
fill(middlePlot, lowerBandPlot, color=lowerFillColor)
