indicator("V-MACD")

fastLength = input.int(title="Fast Length", defval=12)
slowLength = input.int(title="Slow Length", defval=26)
signalLength = input.int(title="Signal Length", defval=9)
showHistogram = input.bool(title="Show Histogram ?", defval=true)
highlightCrossovers = input.bool(title="Highlight V-MACD/Signal Crossovers ?", defval=false)
highlightZeroCrossovers = input.bool(title="Highlight Zero Line Crossovers ?", defval=false)
applyFilling = input.bool(title="Apply Ribbon Filling ?", defval=false)

[vmacd, signal, hist] = macd(volume, fastLength, slowLength, signalLength)

histColor = hist >= 0 ? (hist[1] < hist ? #26A69A : #B2DFDB) : (hist[1] < hist ? #FFCDD2 : #EF5350)

plot(showHistogram ? hist : na, title="Histogram", style=columns, color=histColor)
hline(0, title="Zero Line", linestyle=dotted)

trendColor = vmacd > signal ? #0ebb23 : color.red

vmacdColor = applyFilling ? trendColor : #0094ff
signalColor = applyFilling ? trendColor : #ff6a00

vmacdPlot = plot(vmacd, title="V-MACD", color=vmacdColor)
signalPlot = plot(signal, title="Signal", color=signalColor)

transparent = color(color.white, 100)

fillColor = applyFilling ? trendColor : transparent
fill(vmacdPlot, signalPlot, color=fillColor)

zeroCrossBgColor = highlightZeroCrossovers ? (vmacd > 0 ? color.green : color.red) : transparent
bgcolor(zeroCrossBgColor)

plotshape(highlightCrossovers and crossover(vmacd, signal) ? vmacd : na, title="Crossover", location=location.absolute, style=shape.circle, size=size.tiny, color=color.green)
plotshape(highlightCrossovers and crossunder(vmacd, signal) ? vmacd : na, title="Crossunder", location=location.absolute, style=shape.circle, size=size.tiny, color=color.red)
