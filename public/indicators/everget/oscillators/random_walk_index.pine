indicator("Random Walk Index", shorttitle="RWI")

length = input.int(title="Length", minval=1, defval=14)

rwiHigh = (high - nz(low[length])) / (atr(length) * sqrt(length))
rwiLow = (nz(high[length]) - low) / (atr(length) * sqrt(length))

plot(rwiHigh, title="High", linewidth=2, color=#6d1e7f)
plot(rwiLow, title="Low", linewidth=2, color=#ff3737)
