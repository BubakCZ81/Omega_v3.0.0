indicator("Kirshenbaum Bands", shorttitle="KB", overlay=true)

length = input.int(title="Length", defval=30)
regressionLength = input.int(title="Regression Length", defval=20)
mult = input.float(title="Multiplier", step=0.1, defval=1.75)
src = input.source(title="Source", defval=close)

regression = linreg(src, regressionLength, 0)
stderror = mult * math.sqrt(ta.sma(math.pow(src - regression, 2), regressionLength))

basis = ta.ema(src, length)
upper = basis + stderror
lower = basis - stderror

plot(basis, title="Basis", color=#351c75)
upperBandPlot = plot(upper, title="Upper", color=#45818e)
lowerBandPlot = plot(lower, title="Lower", color=#45818e)
fill(upperBandPlot, lowerBandPlot, title="Background", color=color(#ffd966, 84))
