indicator("Leap Years", overlay=true)

transparency = input.int(title="Transparency", defval=88, minval=0, maxval=100)
showLabels = input.bool(title="Show Labels ? ", defval=true)

transparent = color(color.white, 100)
labelColor = #1e90ff
bgColor = #ffa726

isLeap = false

if year % 4 != 0 // year is not divisible by 4
    // it is a common year
    isLeap := false
else
    if year % 100 != 0 // year is not divisible by 100
        // it is a leap year
        isLeap := true
    else
        if year % 400 != 0 // year is not divisible by 400
            // it is a common year
            isLeap := false
        else
            // it is a leap year
            isLeap := true

lyText = " Leap \nYear "
lyStart = year != year[1] and isLeap
plotshape(showLabels and lyStart, title=lyText, text=lyText, color=labelColor, textcolor=color.white, style=shape.labelup, location=location.belowbar, size=size.small)
bgcolor(title="Leap Year", color=isLeap ? bgColor : transparent, transp=transparency)
