indicator("Repulse")

length = input.int(title="Length", minval=1, defval=5)

bullPower = 100 * (3 * close - 2 * ta.lowest(length) - open[length - 1]) / close

bearPower = 100 * (open[length - 1] + 2 * ta.highest(length) - 3 * close) / close

repulse = ta.ema(bullPower, 5 * length) - ta.ema(bearPower, 5 * length)

repulseColor = repulse >= repulse[1] ? #0ebb23 : color.red
plot(repulse, title="Repulse", linewidth=2, color=repulseColor)

hline(0, title="Zero Level", linestyle=dotted)
