indicator("Pring Special K", shorttitle="PSK")

src = input.source(title="Source", defval=close)

psk = ta.sma(roc(src, 10), 10) +
	ta.sma(roc(src, 10), 15) * 2 +
	ta.sma(roc(src, 10), 20) * 3 +
	ta.sma(roc(src, 15), 30) * 4 +
	ta.sma(roc(src, 50), 40) +
	ta.sma(roc(src, 65), 65) * 2 +
	ta.sma(roc(src, 75), 75) * 3 +
	ta.sma(roc(src, 100), 100) * 4 +
	ta.sma(roc(src, 130), 195) +
	ta.sma(roc(src, 130), 265) * 2 +
	ta.sma(roc(src, 130), 390) * 3 +
	ta.sma(roc(src, 195), 530) * 4

pskColor = psk >= 0.0 ? #0ebb23 : #ff0000

plot(psk, title="PSK", linewidth=2, color=pskColor)

hline(0, title="Zero Level", linestyle=dotted)
