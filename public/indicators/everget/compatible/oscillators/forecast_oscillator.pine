indicator("Forecast Oscillator", shorttitle="FOSC")

length = input.int(title="Length", minval=1, defval=14)
src = input.source(title="Source", defval=close)

fosc = 100 * (src - linreg(src, length, 0)) / src

foscColor = fosc >= 0.0 ? #0ebb23 : #ff0000

plot(fosc, title="FOSC", linewidth=2, color=foscColor)

hline(0, title="Zero Level", linestyle=dotted, color=#989898)
