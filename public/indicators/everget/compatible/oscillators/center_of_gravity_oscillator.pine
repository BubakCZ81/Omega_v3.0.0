indicator("CG Oscillator", shorttitle="CGO")

length = input.int(title="Length", minval=1, defval=10)
applyFilling = input.bool(title="Apply Filling ?", defval=false)
src = input.source(title="Source", defval=hl2)

numeratorSum = 0.0
denominatorSum = 0.0

for i = 0 to length - 1
	numeratorSum := numeratorSum + (i + 1) * nz(src[i])
	denominatorSum := denominatorSum + nz(src[i])

cgo = -numeratorSum / denominatorSum

cgoPlot = plot(cgo, title="CGO", color=#3d85c6)
cgoPrevPlot = plot(cgo[1], title="CGO Prev", color=#ff3e7d)

fillColor = applyFilling ? (cgo > cgo[1] ? #0ebb23 : #cc0000) : color(color.white, 100)
fill(cgoPlot, cgoPrevPlot, color=fillColor)
