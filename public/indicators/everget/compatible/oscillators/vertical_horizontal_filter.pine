indicator("Vertical Horizontal Filter", shorttitle="VHF")

length = input.int(title="Length", minval=1, defval=28)
src = input.source(title="Source", defval=close)

vhf = math.abs(ta.highest(src, length) - ta.lowest(src, length)) / math.sum(math.abs(ta.change(src)), length)

plot(vhf, title="VHF", color=#674ea7)
