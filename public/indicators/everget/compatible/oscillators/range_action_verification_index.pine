indicator("Range Action Verification Index (RAVI)", shorttitle="RAVI")

fastLength = input.int(title="Fast MA Length", minval=1, defval=7)
fastMAInput = input(title="Fast MA", defval="SMA", options=["EMA", "SMA", "VWMA", "WMA"])
slowLength = input.int(title="Slow MA Length", minval=1, defval=65)
slowMAInput = input(title="Slow MA", defval="SMA", options=["EMA", "SMA", "VWMA", "WMA"])
comparisonLookback = input.int(title="Comparison Lookback", minval=1, defval=1)
src = input.source(title="Source", defval=close)

fastMA = iff(fastMAInput == "EMA", ta.ema(src, fastLength),
	 iff(fastMAInput == "SMA", ta.sma(src, fastLength),
	 iff(fastMAInput == "VWMA", vwma(src, fastLength),
	 iff(fastMAInput == "WMA", ta.wma(src, fastLength),
	 na))))

slowMA = iff(slowMAInput == "EMA", ta.ema(src, slowLength),
	 iff(slowMAInput == "SMA", ta.sma(src, slowLength),
	 iff(slowMAInput == "VWMA", vwma(src, slowLength),
	 iff(slowMAInput == "WMA", ta.wma(src, slowLength),
	 na))))

ravi = math.abs(100 * (fastMA - slowMA) / slowMA)

raviColor = ravi > nz(ravi[comparisonLookback]) ? color.green : color.red

plot(ravi, title="RAVI", linewidth=2, color=raviColor)
