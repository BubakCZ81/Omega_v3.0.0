indicator("Pretty Good Oscillator", shorttitle="PGO")

length = input.int(title="Length", defval=14, minval=1)
upperLevel = input.float(title="Upper Level", step=0.1, defval=2.0)
lowerLevel = input.float(title="Lower Level", step=0.1, defval=-2.0)
maxLevel = input.float(title="Max Level", step=0.1, defval=4.0)
minLevel = input.float(title="Min Level", step=0.1, defval=-4.0)
highlightBreakouts = input.bool(title="Highlight Overbought/Oversold Breakouts ?", defval=true)
src = input.source(title="Source", defval=close)

pgo = (src - ta.sma(src, length)) / ta.atr(length)

pgoColor = pgo > upperLevel ? #0ebb23 : pgo < lowerLevel ? #ff0000 : #f4b77d
plot(pgo, title="PGO", linewidth=2, color=pgoColor)

transparent = color(color.white, 100)

maxLevelPlot = hline(maxLevel, title="Max Level", linestyle=dotted, color=transparent)
upperLevelPlot = hline(upperLevel, title="Upper Level", linestyle=dotted)
hline(0, title="Zero Level", linestyle=dotted)
lowerLevelPlot = hline(lowerLevel, title="Lower Level", linestyle=dotted)
minLevelPlot = hline(minLevel, title="Min Level", linestyle=dotted, color=transparent)

fill(upperLevelPlot, lowerLevelPlot, color=color.purple)

upperFillColor = pgo > upperLevel and highlightBreakouts ? color.green : transparent
lowerFillColor = pgo < lowerLevel and highlightBreakouts ? color.red : transparent

fill(maxLevelPlot, upperLevelPlot, color=upperFillColor)
fill(minLevelPlot, lowerLevelPlot, color=lowerFillColor)
