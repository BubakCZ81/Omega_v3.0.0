indicator("Coppock Curve")

length = input.int(title="Smoothing Length", defval=10)
longRocLength = input.int(title="Long ROC Length", defval=14)
shortRocLength = input.int(title="Short ROC Length", defval=11)
src = input.source(title="Source", defval=close)

coppock = ta.wma(roc(src, longRocLength) + roc(src, shortRocLength), length)

coppockColor = coppock > 0 ? #0ebb23 : color.red

plot(coppock, title="Coppock", linewidth=2, color=coppockColor)
hline(0, title="Zero Level", linestyle=dotted)
