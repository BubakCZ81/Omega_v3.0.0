indicator("Awesome Oscillator", shorttitle="AO")

fastLength = input.int(title="Fast Length", defval=5)
slowLength = input.int(title="Slow Length", defval=34)

ao = ta.sma(hl2, fastLength) - ta.sma(hl2, slowLength)

aoColor = ao >= 0 ? (ao[1] < ao ? #26A69A : #B2DFDB) : (ao[1] < ao ? #FFCDD2 : #EF5350)
plot(ao, title="AO", style=plot.style_columns, color=aoColor)
