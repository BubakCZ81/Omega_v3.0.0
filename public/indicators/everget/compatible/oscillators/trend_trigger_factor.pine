indicator("Trend Trigger Factor", shorttitle="TTF")

length = input.int(title="Lookback Length", defval=15)
upperLevel = input.int(title="Upper Trigger Level", defval=100, minval=1)
lowerLevel = input.int(title="Lower Trigger Level", defval=-100, maxval=-1)
highlightBreakouts = input.bool(title="Highlight Overbought/Oversold Breakouts ?", defval=true)
src = input.source(title="Source", defval=close)

hh = ta.highest(length)
ll = ta.lowest(length)

buyPower = hh - nz(ll[length])
sellPower = nz(hh[length]) - ll

ttf = 200 * (buyPower - sellPower) / (buyPower + sellPower)

ttfColor = ttf > upperLevel ? #0ebb23 : ttf < lowerLevel ? #ff0000 : #f4b77d
plot(ttf, title="TTF", linewidth=2, color=ttfColor)

transparent = color(color.white, 100)

maxLevelPlot = hline(200, title="Max Level", linestyle=dotted, color=transparent)
upperLevelPlot = hline(upperLevel, title="Upper Trigger Level", linestyle=dotted)
hline(0, title="Zero Level", linestyle=dotted)
lowerLevelPlot = hline(lowerLevel, title="Lower Trigger Level", linestyle=dotted)
minLevelPlot = hline(-200, title="Min Level", linestyle=dotted, color=transparent)

fill(upperLevelPlot, lowerLevelPlot, color=color.purple)

upperFillColor = ttf > upperLevel and highlightBreakouts ? color.green : transparent
lowerFillColor = ttf < lowerLevel and highlightBreakouts ? color.red : transparent

fill(maxLevelPlot, upperLevelPlot, color=upperFillColor)
fill(minLevelPlot, lowerLevelPlot, color=lowerFillColor)
