indicator("Trendscore", shorttitle="Trendscore")

fromIndex = input.int(title="From", minval=1, defval=11)
toIndex = input.int(title="To", minval=1, defval=20)
src = input.source(title="Source", defval=close)

trendscore(src, fromIndex, toIndex) =>
	sum = 0.0

	for i = fromIndex to toIndex
		sum := src >= nz(src[i]) ? sum + 1 : sum - 1
	sum

plot(trendscore(src, fromIndex, toIndex), title="Trendscore", linewidth=2, color=#e69138)
