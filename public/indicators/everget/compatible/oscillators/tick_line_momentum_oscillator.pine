indicator("Tick Line Momentum Oscillator", shorttitle="TLMO")

cumoMALength = input.int(title="Cumo MA Length", minval=1, defval=10)
cumoMAInput = input(title="Cumo MA", defval="EMA", options=["EMA", "SMA", "VWMA", "WMA"])
rocLength = input.int(title="ROC Length", minval=1, defval=5)
smoothingLength = input.int(title="Smoothing Length", minval=1, defval=5)
smoothingMAInput = input(title="Smoothing MA", defval="EMA", options=["EMA", "SMA", "VWMA", "WMA"])
obosLevel = input.int(title="Overbought / Oversold Level", minval=1, defval=5)
src = input.source(title="Source", defval=close)

cumoMA = iff(cumoMAInput == "EMA", ta.ema(src, cumoMALength),
	 iff(cumoMAInput == "SMA", ta.sma(src, cumoMALength),
	 iff(cumoMAInput == "VWMA", vwma(src, cumoMALength),
	 iff(cumoMAInput == "WMA", ta.wma(src, cumoMALength),
	 na))))

cumoExpression = src > nz(cumoMA[1])
	 ? 1
	 : src < nz(cumoMA[1])
	 	 ? -1
	 	 : 0

tlmo = iff(smoothingMAInput == "EMA", ta.ema(roc(ta.cum(cumoExpression), rocLength), smoothingLength),
	 iff(smoothingMAInput == "SMA", ta.sma(roc(ta.cum(cumoExpression), rocLength), smoothingLength),
	 iff(smoothingMAInput == "VWMA", vwma(roc(ta.cum(cumoExpression), rocLength), smoothingLength),
	 iff(smoothingMAInput == "WMA", ta.wma(roc(ta.cum(cumoExpression), rocLength), smoothingLength),
	 na))))

tlmoColor = tlmo > obosLevel ? #0ebb23 : tlmo < -obosLevel ? #ff0000 : #674ea7
plot(tlmo, title="TLMO", linewidth=2, color=tlmoColor)

hline(obosLevel, title="Overbought", linestyle=dotted, color=#0ebb23)
hline(0, title="Zero Level", linestyle=solid, color=#f6b26b)
hline(-1 * obosLevel, title="Oversold", linestyle=dotted, color=#ff0000)
