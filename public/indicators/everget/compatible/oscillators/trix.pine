indicator("TRIX")

length = input.int(title="Length", defval=14)
mult = input.int(title="TRIX Value Multiplier", defval=1)
signalType = input(title="Signal Smoothing Type", defval="SMA", options=["EMA", "SMA"])
signalLength = input.int(title="Signal Smoothing Length", defval=9)
src = input.source(title="Source", defval=close)
showSignal = input.bool(title="Show Signal Line ?", defval=true)
showHistogram = input.bool(title="Show Histogram ?", defval=false)
highlightCrossovers = input.bool(title="Highlight TRIX/Signal Crossovers ?", defval=true)
highlightZeroCrossovers = input.bool(title="Highlight Zero Line Crossovers ?", defval=false)
applyFilling = input.bool(title="Apply Ribbon Filling ?", defval=false)

triple = ta.ema(ta.ema(ta.ema(src, length), length), length)

trix = mult * roc(triple, 1)
signal = signalType == "SMA" ? ta.sma(trix, signalLength) : ta.ema(trix, signalLength)

hist = trix - signal
histColor = hist >= 0 ? (hist[1] < hist ? #26A69A : #B2DFDB) : (hist[1] < hist ? #FFCDD2 : #EF5350)
plot(showHistogram ? hist : na, title="Histogram", style=plot.style_columns, color=histColor)
hline(0, title="Zero Level", linestyle=dotted)

trendColor = trix > signal ? #0ebb23 : color.red

trixColor = applyFilling ? trendColor : (trix > 0 ? #0ebb23 : color.red)
signalColor = applyFilling ? trendColor : #ff9800

trixPlot = plot(trix, title="TRIX", linewidth=2, color=trixColor)
signalPlot = plot(showSignal ? signal : na, title="Signal", color=signalColor)

transparent = color(color.white, 100)

fillColor = applyFilling ? trendColor : transparent
fill(trixPlot, signalPlot, color=fillColor)

zeroCrossBgColor = highlightZeroCrossovers ? (trix > 0 ? color.green : color.red) : transparent
bgcolor(zeroCrossBgColor)

plotshape(highlightCrossovers and ta.crossover(trix, signal) ? trix : na, title="Crossover", location=location.absolute, style=shape.circle, size=size.tiny, color=color.green)
plotshape(highlightCrossovers and ta.crossunder(trix, signal) ? trix : na, title="Crossunder", location=location.absolute, style=shape.circle, size=size.tiny, color=color.red)
