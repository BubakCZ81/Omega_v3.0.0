// Linear Regression (All Data) script may be freely distributed under the terms of the GPL-3.0 license.
// PineTS compatibility: migrated legacy tostring() calls to str.tostring().
var int MAX_BARS_BACK = 5000
indicator("Linear Regression (All Data)", overlay=true, max_bars_back=MAX_BARS_BACK)

n = bar_index + 1

X = n
Y = input(title="Source", defval=close)

sumX = ta.cum(X)
sumY = ta.cum(Y)
sumX2 = ta.cum(math.pow(X, 2))
sumY2 = ta.cum(math.pow(Y, 2))
sumXY = ta.cum(X * Y)

// Pearson correlation coefficient
r = (n * sumXY - sumX * sumY) / math.sqrt((n * sumY2 - math.pow(sumY, 2)) * (n * sumX2 - math.pow(sumX, 2)))

// Coefficient of determination
r2 = math.pow(r, 2)

meanX = sumX / n
meanY = sumY / n

slope = (n * sumXY - sumX * sumY) / (n * sumX2 - math.pow(sumX, 2))
intercept = meanY - slope * meanX

int startIndex = n > MAX_BARS_BACK ? int(n - MAX_BARS_BACK) : 0
startY = slope * startIndex + intercept
endY = slope * (n - 1) + intercept

var line regLine = na
if barstate.islast
    if na(regLine)
        regLine := line.new(startIndex, startY, bar_index, endY, width=2, extend=extend.none, color=color.orange)
    else
        line.set_xy1(regLine, startIndex, startY)
        line.set_xy2(regLine, bar_index, endY)
        na

//------------------------------------------------------------------------

// Formatter
_format(value, decimals) =>
	out = str.tostring(value, "#.#")
	out :=
		 decimals == 2 ? str.tostring(value, "#.##") :
		 decimals == 3 ? str.tostring(value, "#.###") :
		 decimals == 4 ? str.tostring(value, "#.####") :
		 decimals == 5 ? str.tostring(value, "#.#####") :
		 decimals == 6 ? str.tostring(value, "#.######") :
		 decimals == 7 ? str.tostring(value, "#.#######") :
		 decimals == 8 ? str.tostring(value, "#.########") :
		 decimals == 9 ? str.tostring(value, "#.#########") :
		 decimals == 10 ? str.tostring(value, "#.##########") :
		 decimals == 11 ? str.tostring(value, "#.###########") :
		 decimals == 12 ? str.tostring(value, "#.############") :
		 decimals == 13 ? str.tostring(value, "#.#############") :
		 decimals == 14 ? str.tostring(value, "#.##############") :
		 decimals == 15 ? str.tostring(value, "#.###############") :
		 decimals == 16 ? str.tostring(value, "#.################") :
		 out
	out

summaryText =
     " Slope: " + _format(slope, 6) +
     "\n Intercept: " + _format(intercept, 6) +
     "\n r: " + _format(r, 3) +
     "\n r2: " + _format(r2, 3)

var label summaryLabel = label.new(
	 x=time,
	 y=na,
	 xloc=xloc.bar_time,
	 text="",
	 textalign=text.align_left,
	 textcolor=color.white,
	 color=#1e90ff,
	 style=label.style_label_left,
	 size=size.small
	 )

label.set_text(summaryLabel, summaryText)
label.set_xy(summaryLabel, time + 10 * (time - time[1]), endY)
