indicator("Positive Volume Index", shorttitle="PVI")

initial = input.int(title="Initial Value", defval=100)
signalType = input(title="Signal Smoothing Type", defval="EMA", options=["EMA", "SMA"])
signalLength = input.int(title="Signal Length", defval=255)
highlightCrossovers = input.bool(title="Highlight Crossovers ?", defval=false)
applyFilling = input.bool(title="Apply Ribbon Filling ?", defval=true)

pvi = 0.0
pvi := na(pvi[1]) ? initial : (ta.change(volume) > 0 ? pvi[1] * close / close[1] : pvi[1])
signal = signalType == "EMA" ? ta.ema(pvi, signalLength) : ta.sma(pvi, signalLength)

trendColor = pvi > signal ? #0ebb23 : color.red

pviColor = applyFilling ? trendColor : #0094ff
signalColor = applyFilling ? trendColor : #ff6a00

pviPlot = plot(pvi, title="PVI", color=pviColor)
signalPlot = plot(signal, title="Signal", color=signalColor)

transparent = color(color.white, 100)

fillColor = applyFilling ? trendColor : transparent
fill(pviPlot, signalPlot, color=fillColor)

plotshape(ta.crossover(pvi, signal) and highlightCrossovers ? pvi : na, title="Crossover", location=location.absolute, style=shape.circle, size=size.tiny, color=color.green)
plotshape(ta.crossunder(pvi, signal) and highlightCrossovers ? pvi : na, title="Crossunder", location=location.absolute, style=shape.circle, size=size.tiny, color=color.red)
