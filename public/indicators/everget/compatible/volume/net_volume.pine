indicator("Net Volume", precision=0)

src = input.source(title="Source", defval=close)

nv = math.sign(ta.change(src)) * volume

nvColor = nv >= 0 ? (nv[1] < nv ? #26A69A : #B2DFDB) : (nv[1] < nv ? #FFCDD2 : #EF5350)

plot(nv, title="Net Volume", style=plot.style_columns, linewidth=2, color=nvColor)
