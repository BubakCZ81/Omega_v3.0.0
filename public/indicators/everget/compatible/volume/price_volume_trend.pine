indicator("Price Volume Trend", shorttitle="PVT", format=format.volume)

showSignal = input.bool(title="Show Signal ?", defval=true)
signalType = input(title="Signal Smoothing Type", defval="SMA", options=["EMA", "SMA"])
signalLength = input.integer(title="Signal Smoothing Length", defval=21)
src = input.source(title="Source", defval=close)
highlightCrossovers = input.bool(title="Highlight Crossovers ?", defval=false)
applyFilling = input.bool(title="Apply Ribbon Filling ?", defval=true)

signal = signalType == "EMA" ? ta.ema(pvt, signalLength) : ta.sma(pvt, signalLength)

trendColor = pvt > signal ? #0ebb23 : color.red
pvtColor = applyFilling ? trendColor : #0094ff
signalColor = applyFilling ? trendColor : #ff6a00

pvtPlot = plot(pvt, title="PVT", linewidth=2, color=pvtColor)
signalPlot = plot(showSignal ? signal : na, title="Signal", color=signalColor)

transparent = color.new(color.white, 100)

fillColor = applyFilling ? trendColor : transparent
fill(pvtPlot, signalPlot, color=fillColor)

buyAlert = ta.crossover(pvt, signal)
sellAlert = ta.crossunder(pvt, signal)

plotshape(buyAlert and highlightCrossovers ? pvt : na, title="Crossover", location=location.absolute, style=shape.circle, size=size.tiny, color=color.green)
plotshape(sellAlert and highlightCrossovers ? pvt : na, title="Crossunder", location=location.absolute, style=shape.circle, size=size.tiny, color=color.red)

alertcondition(buyAlert, title="Alert: Buy", message="Buy\nSymbol: {{exchange}}:{{syminfo.ticker}}\nPrice: {{close}}")
alertcondition(sellAlert, title="Alert: Sell", message="Sell\nSymbol: {{exchange}}:{{syminfo.ticker}}\nPrice: {{close}}")
