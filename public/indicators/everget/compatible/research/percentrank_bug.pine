indicator("Percentrank Bug")

src = volume
length = input(14)

pr = ta.percentrank(src, length)
plot(pr, title="Built-in", color=color.red)

_percentrank(src, length) =>
    count = 0
    for i = 1 to length
        count := count + (src >= nz(src[i]) ? 1 : 0)
    pr = 100 * count / length

pr2 = _percentrank(src, length)

plot(pr2, title="Shim", color=color.green)
