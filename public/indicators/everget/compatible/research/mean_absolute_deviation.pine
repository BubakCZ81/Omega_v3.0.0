indicator("Mean Absolute Deviation", shorttitle="MAD")

src = close
len = 14

sma = ta.sma(src, len)

ta.median(src, length) =>
    ta.percentile_nearest_rank(src, length, 50)

dev0 = dev(src, len)
dev1 = src - sma
dev2 = math.sum(math.abs(src - sma), len) / len
dev3 = math.abs(src - sma) / len
dev4 = (src - sma) / len
dev5 = ta.median(src - ta.median(src, len), len)

sum = 0.0
for i = 0 to len - 1
    sum := sum + math.abs(src[i] - sma)

dev6 = sum / len

plot(dev0, title="Built-in", color=color.purple)
plot(dev1, title="1", color=color.olive)
plot(dev2, title="2", color=color.teal)
plot(dev3, title="3", color=color.green)
plot(dev4, title="4", color=color.red)
plot(dev5, title="5", color=color.blue)
plot(dev6, title="6", color=color.orange)
