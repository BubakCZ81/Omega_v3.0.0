indicator("Rate of Change", shorttitle="ROC")

src = close
length = 7

roc = roc(src, length)

roc2 = ta.change(src, length)

roc3 = ta.change(src, length) / src[length]

roc4 = 100 * ta.change(src, length) / src[length]

plot(roc, title="Built-in", color=color.blue)
plot(roc2, title="2", color=color.green)
plot(roc3, title="3", color=color.red)
plot(roc4, title="4", color=color.purple)
