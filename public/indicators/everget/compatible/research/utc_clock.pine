indicator("UTC Clock", overlay=true)

secondsRaw = math.floor(timenow / 1000)
minutesRaw = math.floor(secondsRaw / 60)
hoursRaw = math.floor(minutesRaw / 60)

seconds = secondsRaw % 60
minutes = minutesRaw % 60
hours = hoursRaw % 24

f_format(_val) =>
    (0 < _val and _val < 10 ? "0" : "") + tostring(_val, "##") + (_val == 0 ? "0" : "")

labelText = f_format(hours) + ":" + f_format(minutes) + ":" + f_format(seconds)

var label l = label.new(
     x=bar_index,
     y=na,
     text="",
     textcolor=color.black,
     style=label.style_none,
     size=size.huge
     )

label.set_text(l, labelText)
label.set_xy(l, bar_index, ta.highest(high, 50))
