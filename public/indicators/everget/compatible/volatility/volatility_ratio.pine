indicator("Volatility Ratio", shorttitle="VR")

length = input.int(title="Length", minval=1, defval=14)
breakoutLevel = input.float(title="Breakout Level", step=0.1, defval=0.5)

max = math.max(ta.highest(high, length), close[length + 1])
min = math.min(ta.lowest(low, length), close[length + 1])

vr = tr(true) / (max - min)

vrColor = vr >= breakoutLevel ? #39b361 : #cc4125

plot(vr, title="VR", linewidth=2, color=vrColor)

hline(title="Breakout Level", price=breakoutLevel, linestyle=dotted, color=color.gray)
