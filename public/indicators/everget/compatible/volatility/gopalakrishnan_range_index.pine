indicator("Gopalakrishnan Range Index", shorttitle="GAPO")

length = input.int(title="Length", defval=5)

gapo = math.log(ta.highest(length) - ta.lowest(length)) / math.log(length)

gapoColor = gapo >= gapo[1] ? #0ebb23 : color.red
plot(gapo, title="GAPO", linewidth=2, color=gapoColor)
