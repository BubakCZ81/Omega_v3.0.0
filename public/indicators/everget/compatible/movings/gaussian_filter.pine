indicator("Gaussian Filter", shorttitle="GF", overlay=true)

cyclePeriod = input.integer(title="Cycle Period", minval=1, defval=14)
polesNumber = input.integer(title="Number of Poles", defval=4, options=[1, 2, 3, 4])
src = input.source(title="Source", defval=close)
highlight = input.bool(title="Highlight ?", defval=true)

PI = 2 * math.asin(1)
beta = (1 - cos(2 * PI / cyclePeriod)) / (math.pow(2, 1 / polesNumber) - 1)
alpha = -beta + math.sqrt(math.pow(beta, 2) + 2 * beta)

_gf(poles) =>
	filter = 0.0
	filter1 = nz(filter[1], src)
	filter2 = nz(filter[2], filter1)
	filter3 = nz(filter[3], filter2)
	filter4 = nz(filter[4], filter3)

	if poles == 1
		filter := alpha * src + (1 - alpha) * filter1

	if poles == 2
		filter :=
			 math.pow(alpha, 2) * src +
			 2 * (1 - alpha) * filter1 -
			 math.pow(1 - alpha, 2) * filter2

	if poles == 3
		filter :=
			 math.pow(alpha, 3) * src +
			 3 * (1 - alpha) * filter1 -
			 3 * math.pow(1 - alpha, 2) * filter2 +
			 math.pow(1 - alpha, 3) * filter3

	if poles == 4
		filter :=
			 math.pow(alpha, 4) * src +
			 4 * (1 - alpha) * filter1 -
			 6 * math.pow(1 - alpha, 2) * filter2 +
			 4 * math.pow(1 - alpha, 3) * filter3 -
			 math.pow(1 - alpha, 4) * filter4
	filter

gf = _gf(polesNumber)
gfColor = highlight ? gf > gf[1] ? color.green : color.red : #6d1e7f
plot(gf, title="GF", linewidth=2, color=gfColor)
