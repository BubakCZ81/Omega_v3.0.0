indicator("Apirine Adaptive Moving Average", shorttitle="AAMA", overlay=true)

length = input.integer(title="Length", defval=14)
fastLength = input.integer(title="Fast EMA Length", defval=2)
slowLength = input.integer(title="Slow EMA Length", defval=30)
src = input.source(title="Source", defval=close)
highlight = input.bool(title="Highlight ?", defval=true)

fastAlpha = 2 / (fastLength + 1)
slowAlpha = 2 / (slowLength + 1)

hh = ta.highest(length + 1)
ll = ta.lowest(length + 1)

mltp = hh - ll != 0 ? math.abs(2 * src - ll - hh) / (hh - ll) : 0

ssc = mltp * (fastAlpha - slowAlpha) + slowAlpha

aama = 0.0
aama := nz(aama[1], src) + math.pow(ssc, 2) * (src - nz(aama[1], src))

aamaColor = highlight ? aama > aama[1] ? color.green : color.red : #6d1e7f
plot(aama, title="AAMA", linewidth=2, color=aamaColor)
