indicator("Hull Moving Average", shorttitle="HMA", overlay=true)

length = input.int(title="Length", defval=14, minval=1)
src = input.source(title="Source", defval=close)

hma(src, length) =>
	ta.wma(2 * ta.wma(src, length / 2) - ta.wma(src, length), math.round(math.sqrt(length)))

plot(hma(src, length), title="HMA", linewidth=2, color=#6d1e7f)
