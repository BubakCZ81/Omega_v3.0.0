indicator("Moving Median", shorttitle="MM", overlay=true)

length = input.integer(title="Length", defval=14)
highlight = input.bool(title="Highlight ?", defval=true)
src = input.source(title="Source", defval=close)

median = ta.percentile_nearest_rank(src, length, 50)

medianColor = highlight ? median > median[1] ? color.green : color.red : #6d1e7f
plot(median, title="MM", linewidth=2, color=medianColor)
