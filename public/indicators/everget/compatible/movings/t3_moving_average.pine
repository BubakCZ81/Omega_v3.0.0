indicator("T3 Moving Average", shorttitle="T3", overlay=true)

length = input.integer(title="Length", defval=5)
factor = input.float(title="Factor", minval=0, maxval=1, defval=0.7)
src = input.source(title="Source", defval=close)
highlight = input.bool(title="Highlight ?", defval=true)

_gd(src, length) =>
	ta.ema(src, length) * (1 + factor) - ta.ema(ta.ema(src, length), length) * factor

t3 = _gd(_gd(_gd(src, length), length), length)

t3Color = highlight ? t3 > t3[1] ? color.green : color.red : #6d1e7f
plot(t3, title="T3", linewidth=2, color=t3Color)
