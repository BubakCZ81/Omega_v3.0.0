indicator("Kaufman Adaptive Moving Average", shorttitle="KAMA", overlay=true)

length = input.integer(title="Length", defval=14)
fastLength = input.integer(title="Fast EMA Length", defval=2)
slowLength = input.integer(title="Slow EMA Length", defval=30)
src = input.source(title="Source", defval=close)
highlight = input.bool(title="Highlight ?", defval=true)

mom = math.abs(ta.change(src, length))
volatility = math.sum(math.abs(ta.change(src)), length)

// Efficiency Ratio
er = volatility != 0 ? mom / volatility : 0

fastAlpha = 2 / (fastLength + 1)
slowAlpha = 2 / (slowLength + 1)

alpha = math.pow(er * (fastAlpha - slowAlpha) + slowAlpha, 2)

kama = 0.0
kama := alpha * src + (1 - alpha) * nz(kama[1], src)

kamaColor = highlight ? kama > kama[1] ? color.green : color.red : #6d1e7f
plot(kama, title="KAMA", linewidth=2, color=kamaColor)
