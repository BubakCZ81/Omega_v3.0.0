indicator("McGinley Dynamic", shorttitle="MD", overlay=true)

length = input.int(title="Length", minval=1, defval=14)
k = input.float(title="K", step=0.1, defval=0.6)
src = input.source(title="Source", defval=close)

md(src, length, k) =>
	md = 0.0
	md := na(md[1]) ? src : md[1] + (src - md[1]) / (k * length * math.pow(src / md[1], 4))

plot(md(src, length, k), title="MD", linewidth=2, color=#6d1e7f)
