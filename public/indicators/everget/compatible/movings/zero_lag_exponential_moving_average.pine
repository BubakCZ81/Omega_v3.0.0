indicator("Zero Lag Exponential Moving Average", shorttitle="ZLEMA", overlay=true)

length = input.integer(title="Length", defval=14)
src = input.source(title="Source", defval=close)
highlight = input.bool(title="Highlight ?", defval=true)

lag = math.floor((length - 1) / 2)
zlema = ta.ema(src + (src - src[lag]), length)

zlemaColor = highlight ? zlema > zlema[1] ? color.green : color.red : #6d1e7f
plot(zlema, title="ZLEMA", linewidth=2, color=zlemaColor)
