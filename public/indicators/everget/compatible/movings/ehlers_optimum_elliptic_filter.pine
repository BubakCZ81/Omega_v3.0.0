indicator("Ehlers Optimum Elliptic Filter", shorttitle="OEF", overlay=true)

src = input.source(title="Source", defval=hl2)
highlightMovements = input.bool(title="Highlight Movements ?", defval=false)

oef = 0.0
oef := 0.13785 * src + 0.0007 * nz(src[1]) + 0.13785 * nz(src[2]) + 1.2103 * nz(oef[1]) - 0.4867 * nz(oef[2])

oefColor = highlightMovements ? (oef > oef[1] ? color.green : color.red) : #6d1e7f
plot(oef, title="OEF", linewidth=2, color=oefColor)
