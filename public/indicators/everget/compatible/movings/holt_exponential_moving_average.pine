indicator("Holt Exponential Moving Average", shorttitle="HEMA", overlay=true)

alphaLength = input.integer(title="Alpha Length", defval=20, minval=1)
gammaLength = input.integer(title="Gamma Length", defval=20, minval=1)
src = input.source(title="Source", defval=close)
highlight = input.bool(title="Highlight ?", defval=true)

alpha = 2 / (alphaLength + 1)
gamma = 2 / (gammaLength + 1)

b = 0.0
hema = 0.0

hema := (1 - alpha) * (nz(hema[1]) + nz(b[1], src)) + alpha * src
b := (1 - gamma) * nz(b[1]) + gamma * (hema - nz(hema[1]))

hemaColor = highlight ? hema > hema[1] ? color.green : color.red : #6d1e7f
plot(hema, title="HEMA", linewidth=2, color=hemaColor)
