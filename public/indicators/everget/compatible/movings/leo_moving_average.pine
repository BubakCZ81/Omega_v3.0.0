indicator("Leo Moving Average", shorttitle="LMA", overlay=true)

length = input.int(title="Length", minval=1, defval=14)
highlightMovements = input.bool(title="Highlight Movements ?", defval=true)
src = input.source(title="Source", defval=close)

lma = 2 * ta.wma(src, length) - ta.sma(src, length)

lmaColor = highlightMovements ? (lma > lma[1] ? color.green : color.red) : #6d1e7f

plot(lma, title="LMA", linewidth=2, color=lmaColor)
