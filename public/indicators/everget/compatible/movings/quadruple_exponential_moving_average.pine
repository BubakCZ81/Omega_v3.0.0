indicator("Quadruple Exponential Moving Average", shorttitle="QEMA", overlay=true)

length = input.int(title="Length", defval=20)
highlightMovements = input.bool(title="Highlight Movements ?", defval=true)
src = input.source(title="Source", defval=close)

ema1 = ta.ema(src, length)
ema2 = ta.ema(ema1, length)
ema3 = ta.ema(ema2, length)
ema4 = ta.ema(ema3, length)
ema5 = ta.ema(ema4, length)

qema = 5 * ema1 - 10 * ema2 + 10 * ema3 - 5 * ema4 + ema5

qemaColor = highlightMovements ? (qema > qema[1] ? color.green : color.red) : #6d1e7f
plot(qema, title="QEMA", linewidth=2, color=qemaColor)
