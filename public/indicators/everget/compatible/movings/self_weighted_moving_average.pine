indicator("Self-Weighted Moving Average", shorttitle="SEWMA", overlay=true)

length = input.int(title="Length", minval=1, defval=14)
highlightMovements = input.bool(title="Highlight Movements ?", defval=false)
src = input.source(title="Source", defval=close)

sum = 0.0
weightSum = 0.0

for i = 0 to length - 1
	weight = src[length + i]
	weightSum := weightSum + weight
	sum := sum + weight * src[i]

sewma = sum / weightSum

sewmaColor = highlightMovements ? (sewma > sewma[1] ? color.green : color.red) : #6d1e7f
plot(sewma, title="SEWMA", linewidth=2, color=sewmaColor)
