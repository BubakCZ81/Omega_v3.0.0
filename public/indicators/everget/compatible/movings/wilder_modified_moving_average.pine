indicator("Wilder Modified Moving Average", shorttitle="WMMA", overlay=true)

length = input.int(title="Length", minval=1, defval=14)
src = input.source(title="Source", defval=close)

plot(ta.rma(src, length), title="WMMA", linewidth=2, color=#6d1e7f)
