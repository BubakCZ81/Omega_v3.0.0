indicator("Negative Volume Index", shorttitle="NVI")

initial = input.int(title="Initial Value", defval=100)
signalType = input(title="Signal Smoothing Type", defval="EMA", options=["EMA", "SMA"])
signalLength = input.int(title="Signal Length", defval=255)
highlightCrossovers = input.bool(title="Highlight Crossovers", defval=false)
applyFilling = input.bool(title="Apply Ribbon Filling ?", defval=true)

nvi = 0.0
nvi := na(nvi[1]) ? initial : (change(volume) < 0 ? nvi[1] * close / close[1] : nvi[1])
signal = signalType == "EMA" ? ema(nvi, signalLength) : sma(nvi, signalLength)

trendColor = nvi > signal ? #0ebb23 : color.red

nviColor = applyFilling ? trendColor : #0094ff
signalColor = applyFilling ? trendColor : #ff6a00

nviPlot = plot(nvi, title="NVI", color=nviColor)
signalPlot = plot(signal, title="Signal", color=signalColor)

transparent = color(color.white, 100)

fillColor = applyFilling ? trendColor : transparent
fill(nviPlot, signalPlot, color=fillColor)

plotshape(crossover(nvi, signal) and highlightCrossovers ? nvi : na, title="Crossover", location=location.absolute, style=shape.circle, size=size.tiny, color=color.green)
plotshape(crossunder(nvi, signal) and highlightCrossovers ? nvi : na, title="Crossunder", location=location.absolute, style=shape.circle, size=size.tiny, color=color.red)
