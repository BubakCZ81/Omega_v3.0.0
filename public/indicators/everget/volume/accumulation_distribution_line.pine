indicator("Accumulation/Distribution Line", shorttitle="Accum/Dist", precision=0)

showSignal = input.bool(title="Show Signal ?", defval=true)
signalType = input(title="Signal Smoothing Type", defval="SMA", options=["EMA", "SMA"])
signalLength = input.int(title="Signal Smoothing Length", defval=21)
highlightCrossovers = input.bool(title="Highlight Crossovers ?", defval=false)
applyFilling = input.bool(title="Apply Ribbon Filling ?", defval=true)

signal = signalType == "EMA" ? ema(accdist, signalLength) : sma(accdist, signalLength)

trendColor = accdist > signal ? #0ebb23 : color.red

adColor = applyFilling ? trendColor : #0094ff
signalColor = applyFilling ? trendColor : #ff6a00

adPlot = plot(accdist, title="Accum/Dist", linewidth=2, color=adColor)
signalPlot = plot(showSignal ? signal : na, title="Signal", color=signalColor)

transparent = color(color.white, 100)

fillColor = applyFilling ? trendColor : transparent
fill(adPlot, signalPlot, color=fillColor)

plotshape(crossover(accdist, signal) and highlightCrossovers ? accdist : na, title="Crossover", location=location.absolute, style=shape.circle, size=size.tiny, color=color.green)
plotshape(crossunder(accdist, signal) and highlightCrossovers ? accdist : na, title="Crossunder", location=location.absolute, style=shape.circle, size=size.tiny, color=color.red)
