indicator("Triangular Moving Average", shorttitle="TMA", overlay=true)

length = input.int(title="Length", minval=1, defval=20)
highlightMovements = input.bool(title="Highlight Movements ?", defval=true)
src = input.source(title="Source", defval=close)

tma = sma(sma(src, ceil(length / 2)), floor(length / 2) + 1)
tmaColor = highlightMovements ? (tma > tma[1] ? color.green : color.red) : #6d1e7f

plot(tma, title="TMA", linewidth=2, color=tmaColor)
