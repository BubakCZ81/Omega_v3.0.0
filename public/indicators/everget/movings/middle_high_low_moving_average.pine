indicator("Middle-High-Low Moving Average", shorttitle="MHLMA", overlay=true)

length = input.int(title="Length", minval=1, defval=14)
mhlRange = input.int(title="High-Low Range", defval=10)
maType = input(title="MA Type", defval="EMA", options=["EMA", "SMA"])
highlightMovements = input.bool(title="Highlight Movements ?", defval=true)

mhl = avg(highest(mhlRange), lowest(mhlRange))
mhlma = maType == "EMA" ? ema(mhl, length) : sma(mhl, length)

mhlmaColor = highlightMovements ? (mhlma > mhlma[1] ? color.green : color.red) : #6d1e7f

plot(mhlma, title="MHLMA", linewidth=2, color=mhlmaColor)
