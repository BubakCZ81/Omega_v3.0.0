indicator("Double Exponential Moving Average", shorttitle="DEMA", overlay=true)

length = input.int(title="Length", minval=1, defval=14)
src = input.source(title="Source", defval=close)

dema(src, length) =>
	ema1 = ema(src, length)
	ema2 = ema(ema1, length)
	dema = 2 * ema1 - ema2

plot(dema(src, length), title="DEMA", linewidth=2, color=#6d1e7f)
