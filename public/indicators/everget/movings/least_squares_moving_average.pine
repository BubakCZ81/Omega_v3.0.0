indicator("Least Squares Moving Average", shorttitle="LSMA", overlay=true)

length = input.int(title="Length", minval=1, defval=14)
offset = input.int(title="Offset", defval=0)
src = input.source(title="Source", defval=close)

plot(linreg(src, length, offset), title="LSMA", linewidth=2, color=#6d1e7f)
