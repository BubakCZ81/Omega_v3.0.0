indicator(title="Variable Index Dynamic Average", shorttitle="VIDYA", overlay=true)

length = input.int(title="Length", defval=14)
highlightMovements = input.bool(title="Highlight Movements ?", defval=true)
src = input.source(title="Source", defval=close)

// Chande Momentum Oscillator
getCMO(src, length) =>
    mom = change(src)
    upSum = sum(max(mom, 0), length)
    downSum = sum(-min(mom, 0), length)
    out = (upSum - downSum) / (upSum + downSum)
    out

cmo = abs(getCMO(src, length))

alpha = 2 / (length + 1)

vidya = 0.0
vidya := src * alpha * cmo + nz(vidya[1]) * (1 - alpha * cmo)

vidyaColor = highlightMovements ? (vidya > vidya[1] ? color.green : color.red) : #6d1e7f
plot(vidya, title="VIDYA", linewidth=2, color=vidyaColor)
