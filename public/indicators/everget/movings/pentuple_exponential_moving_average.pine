indicator("Pentuple Exponential Moving Average", shorttitle="PEMA", overlay=true)

length = input.int(title="Length", defval=20)
highlightMovements = input.bool(title="Highlight Movements ?", defval=true)
src = input.source(title="Source", defval=close)

ema1 = ema(src, length)
ema2 = ema(ema1, length)
ema3 = ema(ema2, length)
ema4 = ema(ema3, length)
ema5 = ema(ema4, length)
ema6 = ema(ema5, length)
ema7 = ema(ema6, length)
ema8 = ema(ema7, length)

pema = 8 * ema1 - 28 * ema2 + 56 * ema3 - 70 * ema4 + 56 * ema5 - 28 * ema6 + 8 * ema7 - ema8

pemaColor = highlightMovements ? (pema > pema[1] ? color.green : color.red) : #6d1e7f
plot(pema, title="PEMA", linewidth=2, color=pemaColor)
